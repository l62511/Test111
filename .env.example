# ===== LLM 配置 =====
# 任何 OpenAI 兼容端点都可以
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 数据配置 =====
# JSON 数据目录，相对路径按项目根目录解析
# 内含 users.json / orders.json / refunds.json，由 python -m data.seed 生成
ORDER_DATA_DIR=data

# ===== 商家后台 =====
# 会话 cookie 的签名密钥。生产环境务必改成随机长字符串。
MERCHANT_SECRET=change-this-in-production

# ===== 演示密码（可选）=====
# 不配置时使用 seed.py 里的默认值：顾客 123456 / 商家 admin123
# DEMO_CUSTOMER_PASSWORD=
# DEMO_MERCHANT_PASSWORD=
