# ===== LLM 配置 =====
# 任何 OpenAI 兼容端点都可以
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 业务配置 =====
# 数据库路径，相对路径按项目根目录解析
ORDER_DB_PATH=data/orders.db

# 当前会话调用方身份。stdio 模式下由此值绑定，Agent 无法篡改。
# 用户名从数据库读取，无需在此配置。
# 可选：u_1001(张伟) / u_1002(李娜) / u_1003(王强)
CALLER_ID=u_1001
